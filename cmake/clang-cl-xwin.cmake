set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)

if(DEFINED ENV{LLVM_BIN})
    set(LLVM_BIN $ENV{LLVM_BIN})
else()
    file(GLOB LLVM_BIN_CANDIDATES LIST_DIRECTORIES true /usr/lib/llvm-*/bin)
    if(NOT LLVM_BIN_CANDIDATES)
        message(FATAL_ERROR "No /usr/lib/llvm-*/bin found; set LLVM_BIN to the LLVM bin directory")
    endif()
    list(SORT LLVM_BIN_CANDIDATES COMPARE NATURAL ORDER DESCENDING)
    list(GET LLVM_BIN_CANDIDATES 0 LLVM_BIN)
endif()

if(DEFINED ENV{XWIN_DIR})
    set(XWIN_DIR $ENV{XWIN_DIR})
else()
    set(XWIN_DIR $ENV{HOME}/.xwin)
endif()

set(CMAKE_C_COMPILER ${LLVM_BIN}/clang-cl)
set(CMAKE_LINKER ${LLVM_BIN}/lld-link)
set(CMAKE_AR ${LLVM_BIN}/llvm-lib)
set(CMAKE_RC_COMPILER ${LLVM_BIN}/llvm-rc)
set(CMAKE_MT ${LLVM_BIN}/llvm-mt)
set(CMAKE_TRY_COMPILE_CONFIGURATION Release)

set(XWIN_INCLUDES "/imsvc ${XWIN_DIR}/crt/include /imsvc ${XWIN_DIR}/sdk/include/ucrt /imsvc ${XWIN_DIR}/sdk/include/um /imsvc ${XWIN_DIR}/sdk/include/shared")
set(XWIN_LIBS "/libpath:${XWIN_DIR}/crt/lib/x86_64 /libpath:${XWIN_DIR}/sdk/lib/um/x86_64 /libpath:${XWIN_DIR}/sdk/lib/ucrt/x86_64")
set(CMAKE_C_FLAGS_INIT "${XWIN_INCLUDES}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "${XWIN_LIBS}")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${XWIN_LIBS}")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "${XWIN_LIBS}")
